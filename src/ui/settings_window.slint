// settings_window.slint — 独立配置窗口
//
// 职责：
//   - 独立 OS 窗口，与主窗口分离，设置时不影响终端
//   - 侧边导航栏 + 右侧内容区布局（亮色主题）
//   - 两个分类页：通用配置 + 启动项配置
//   - 通用配置：字体、颜色、光标、配色方案、声音、scrollback、默认启动项
//   - 启动项配置：Profile 列表的增删改查
//
// 通信（与 Rust 侧 controller.rs 交互）：
//   入：general-settings (GeneralSettingsInfo)
//   入：profile-list ([ProfileEditInfo])
//   出：callback save-general(GeneralSettingsInfo)
//   出：callback save-profile(ProfileEditInfo)
//   出：callback add-profile()
//   出：callback delete-profile(string)
//   出：callback cancelled()
//
// 注意：此文件独立编译，不 import 项目内其他 .slint 文件，
// 避免跨编译单元 struct 类型冲突。所有 struct 在此文件内独立定义。

import { ScrollView } from "std-widgets.slint";

export struct GeneralSettingsInfo {
    font-family: string,
    font-size: int,
    background-color: string,
    cursor-style: string,
    color-scheme: string,
    bell-sound: bool,
    scrollback-limit: int,
    default-profile-id: string,
}

export struct ProfileEditInfo {
    id: string,
    name: string,
    command: string,
    args: string,
    working-directory: string,
    env-vars: string,
}

export component SettingsWindow inherits Window {
    title: "terma 设置";
    preferred-width: 800px;
    preferred-height: 640px;
    min-width: 520px;
    min-height: 420px;
    background: #ffffff;

    // ─── 亮色主题色板 ───
    // 主色 / 侧边栏 / 文本 / 边框
    out property <color> c-primary: #1a73e8;
    out property <color> c-primary-hover: #1557b0;
    out property <color> c-sidebar-bg: #f5f6f7;
    out property <color> c-content-bg: #ffffff;
    out property <color> c-text: #1f1f1f;
    out property <color> c-text-secondary: #5f6368;
    out property <color> c-text-hint: #9aa0a6;
    out property <color> c-border: #dadce0;
    out property <color> c-hover: #e8eaed;
    out property <color> c-selected-soft: #e8f0fe;
    out property <color> c-danger: #d93025;

    // ─── Rust 侧注入的数据 ───
    in property <GeneralSettingsInfo> general-settings;
    in property <[ProfileEditInfo]> profile-list;
    in-out property <int> selected-index: 0;

    // ─── 回调 ───
    callback save-general(GeneralSettingsInfo);
    callback save-profile(ProfileEditInfo);
    callback add-profile();
    callback delete-profile(string);
    callback cancelled();

    // ─── 本地草稿 ───
    property <GeneralSettingsInfo> general-draft: root.general-settings;
    property <ProfileEditInfo> profile-draft;

    // 选中索引变化或列表变化时，刷新 profile-draft
    changed selected-index => {
        root.refresh-profile-draft();
    }
    changed profile-list => {
        root.refresh-profile-draft();
    }

    function refresh-profile-draft() {
        if root.selected-index >= 0 && root.selected-index < root.profile-list.length {
            root.profile-draft = root.profile-list[root.selected-index];
        }
    }

    // ─── 默认启动项下拉框状态 ───
    // 选中索引：初始/同步值由 Rust 侧按 default-profile-id 反查注入
    in-out property <int> default-index: -1;
    // 当前选中项显示文本："名称(命令)"，未选中时为空
    property <string> default-label:
        (root.default-index >= 0 && root.default-index < root.profile-list.length)
        ? (root.profile-list[root.default-index].name + "(" + root.profile-list[root.default-index].command + ")")
        : "";

    // ─── 当前激活的分类页：0=通用配置, 1=启动项配置 ───
    property <int> active-tab: 0;

    HorizontalLayout {
        // ═══ 左侧：侧边导航栏 ═══
        Rectangle {
            width: 172px;
            background: root.c-sidebar-bg;

            VerticalLayout {
                padding-top: 20px;
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 12px;
                spacing: 6px;

                // 标题
                Text {
                    text: "设置";
                    color: root.c-text;
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-alignment: left;
                    height: 30px;
                    vertical-alignment: center;
                }

                Rectangle { height: 5px; }

                // 导航主体（可滚动，启动项过多时不溢出）
                ScrollView {
                vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;

                        // 导航项：通用配置
                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: root.active-tab == 0 ? root.c-primary : (nav0-touch.has-hover ? root.c-hover : transparent);

                            Text {
                                x: 12px;
                                text: "通用配置";
                                color: root.active-tab == 0 ? #ffffff : root.c-text;
                                font-size: 14px;
                                font-weight: root.active-tab == 0 ? 600 : 400;
                                vertical-alignment: center;
                            }
                            nav0-touch := TouchArea {
                                clicked => { root.active-tab = 0; }
                            }
                        }

                        // 导航项：启动项配置
                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: root.active-tab == 1 ? root.c-primary : (nav1-touch.has-hover ? root.c-hover : transparent);

                            Text {
                                x: 12px;
                                text: "启动项配置";
                                color: root.active-tab == 1 ? #ffffff : root.c-text;
                                font-size: 14px;
                                font-weight: root.active-tab == 1 ? 600 : 400;
                                vertical-alignment: center;
                            }
                            nav1-touch := TouchArea {
                                clicked => { root.active-tab = 1; }
                            }
                        }

                        // ── 启动项子级节点（缩进体现层级从属） ──
                        for profile[i] in root.profile-list : Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: (root.active-tab == 1 && i == root.selected-index)
                                ? root.c-selected-soft
                                : (nav-prof-touch.has-hover ? root.c-hover : transparent);

                            HorizontalLayout {
                                padding-left: 34px;
                                padding-right: 10px;
                                spacing: 6px;

                                Text {
                                    text: profile.name;
                                    color: (root.active-tab == 1 && i == root.selected-index) ? root.c-primary : root.c-text-secondary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                // 默认启动项标记
                                Text {
                                    text: profile.id == root.general-settings.default-profile-id ? "★" : "";
                                    color: root.c-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            nav-prof-touch := TouchArea {
                                clicked => {
                                    // 选中子节点 = 切到启动项页并选中对应 Profile
                                    root.active-tab = 1;
                                    root.selected-index = i;
                                }
                            }
                        }

                        // ── 添加启动项（子级节点样式，主色引导点击） ──
                        Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: nav-add-touch.has-hover ? root.c-hover : transparent;

                            Text {
                                x: 34px;
                                text: "+ 添加启动项";
                                color: root.c-primary;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            nav-add-touch := TouchArea {
                                clicked => {
                                    root.active-tab = 1;
                                    root.add-profile();
                                }
                            }
                        }
                    }
                }
            }
        }

        // ═══ 右侧：内容区 + 底部按钮栏 ═══
        VerticalLayout {
            // ─── 内容区（可滚动，适配窗口缩放） ───
            Rectangle {
                vertical-stretch: 1;
                background: root.c-content-bg;
                clip: true;

                // ═══ 通用配置页 ═══
                if root.active-tab == 0 : Rectangle {
                    ScrollView {
                        VerticalLayout {
                            padding: 28px;
                            spacing: 18px;

                            Text {
                                text: "外观";
                                color: root.c-text;
                                font-size: 17px;
                                font-weight: 700;
                            }

                            // 字体
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "字体";
                                    color: root.c-text-secondary;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    width: 100px;
                                }
                                TextInput {
                                    font-size: 14px;
                                    width: 220px;
                                    text: root.general-draft.font-family;
                                    edited => { root.general-draft.font-family = self.text; }
                                }
                            }

                            // 字号
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "字号";
                                    color: root.c-text-secondary;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    width: 100px;
                                }
                                TextInput {
                                    font-size: 14px;
                                    width: 60px;
                                    text: root.general-draft.font-size;
                                    edited => {
                                        if self.text.to-float() > 0 {
                                            root.general-draft.font-size = self.text.to-float();
                                        }
                                    }
                                }
                                Text {
                                    text: "px";
                                    color: root.c-text-hint;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }

                            // 背景色
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "背景色";
                                    color: root.c-text-secondary;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    width: 100px;
                                }
                                TextInput {
                                    font-size: 14px;
                                    width: 120px;
                                    text: root.general-draft.background-color;
                                    edited => { root.general-draft.background-color = self.text; }
                                }
                                // 背景色预览块
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: root.c-border;
                                    background: #2d2d2d;
                                }
                            }

                            // 光标样式
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "光标样式";
                                    color: root.c-text-secondary;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    width: 100px;
                                }
                                TextInput {
                                    font-size: 14px;
                                    width: 120px;
                                    text: root.general-draft.cursor-style;
                                    edited => { root.general-draft.cursor-style = self.text; }
                                }
                                Text {
                                    text: "(block / beam / underline)";
                                    color: root.c-text-hint;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            // 配色方案
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "配色方案";
                                    color: root.c-text-secondary;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    width: 100px;
                                }
                                TextInput {
                                    font-size: 14px;
                                    width: 120px;
                                    text: root.general-draft.color-scheme;
                                    edited => { root.general-draft.color-scheme = self.text; }
                                }
                                Text {
                                    text: "(default / solarized-dark / dracula)";
                                    color: root.c-text-hint;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            // 声音
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "响铃";
                                    color: root.c-text-secondary;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    width: 100px;
                                }
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: root.general-draft.bell-sound ? root.c-primary : #b0b4b8;
                                    background: root.general-draft.bell-sound ? root.c-primary : #ffffff;
                                    bell-touch := TouchArea {
                                        clicked => {
                                            root.general-draft.bell-sound = !root.general-draft.bell-sound;
                                        }
                                    }
                                    Text {
                                        text: root.general-draft.bell-sound ? "\u{2713}" : "";
                                        color: #ffffff;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: "终端响铃时播放声音";
                                    color: root.c-text-secondary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }

                            // 组间留白：分组之间间距明显大于组内
                            Rectangle { height: 14px; }

                            Text {
                                text: "行为";
                                color: root.c-text;
                                font-size: 17px;
                                font-weight: 700;
                            }

                            // Scrollback 上限
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Scrollback 上限";
                                    color: root.c-text-secondary;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    width: 100px;
                                }
                                TextInput {
                                    font-size: 14px;
                                    width: 80px;
                                    text: root.general-draft.scrollback-limit;
                                    edited => {
                                        if self.text.to-float() >= 0 {
                                            root.general-draft.scrollback-limit = self.text.to-float();
                                        }
                                    }
                                }
                                Text {
                                    text: "行（0=无限制）";
                                    color: root.c-text-hint;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            // 组间留白：分组之间间距明显大于组内
                            Rectangle { height: 14px; }

                            Text {
                                text: "默认启动项";
                                color: root.c-text;
                                font-size: 17px;
                                font-weight: 700;
                            }

                            // 默认启动项下拉框（选项格式：名称(命令)）
                            HorizontalLayout {
                                spacing: 10px;

                                Text {
                                    text: "启动项";
                                    color: root.c-text-secondary;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    width: 100px;
                                }

                                default-dd := Rectangle {
                                    width: 260px;
                                    height: 34px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: dd-touch.has-hover ? root.c-primary : root.c-border;
                                    background: #ffffff;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 10px;
                                        spacing: 8px;

                                        Text {
                                            text: root.default-label == "" ? "请选择启动项" : root.default-label;
                                            color: root.default-label == "" ? root.c-text-hint : root.c-text;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        // 下拉箭头
                                        Text {
                                            text: "\u{25BE}";
                                            color: root.c-text-secondary;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    dd-touch := TouchArea {
                                        clicked => {
                                            default-pop.show();
                                        }
                                    }

                                    // 下拉选项浮层
                                    default-pop := PopupWindow {
                                        y: 38px;
                                        width: default-dd.width;

                                        Rectangle {
                                            background: #ffffff;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: root.c-border;
                                            clip: true;

                                            VerticalLayout {
                                                padding: 4px;
                                                spacing: 2px;

                                                // 空列表提示
                                                if root.profile-list.length == 0 : Text {
                                                    text: "暂无启动项";
                                                    color: root.c-text-hint;
                                                    font-size: 13px;
                                                    horizontal-alignment: center;
                                                    height: 32px;
                                                    vertical-alignment: center;
                                                }

                                                // 选项：名称(命令)
                                                for profile[i] in root.profile-list : Rectangle {
                                                    height: 32px;
                                                    border-radius: 4px;
                                                    background: i == root.default-index ? root.c-selected-soft : (opt-touch.has-hover ? root.c-hover : transparent);

                                                    Text {
                                                        x: 10px;
                                                        text: profile.name + "(" + profile.command + ")";
                                                        color: i == root.default-index ? root.c-primary : root.c-text;
                                                        font-size: 13px;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }

                                                    opt-touch := TouchArea {
                                                        clicked => {
                                                            root.default-index = i;
                                                            root.general-draft.default-profile-id = profile.id;
                                                            default-pop.close();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // 弹性填充
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }

                // ═══ 启动项配置页（列表已由左侧导航承担，此处仅保留编辑表单） ═══
                if root.active-tab == 1 : Rectangle {
                    background: root.c-content-bg;
                    clip: true;

                    ScrollView {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 18px;

                            // 无启动项时的空状态提示
                            if root.profile-list.length == 0 : Text {
                                text: "暂无启动项，点击左侧导航「+ 添加启动项」创建";
                                color: root.c-text-hint;
                                font-size: 14px;
                            }

                                // 仅在有选中项时显示编辑表单
                                if root.profile-list.length > 0 : VerticalLayout {
                                    spacing: 18px;

                                    // 名称
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: "名称";
                                            color: root.c-text-secondary;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                            width: 90px;
                                        }
                                        TextInput {
                                            font-size: 14px;
                                            width: 250px;
                                            text: root.profile-draft.name;
                                            edited => { root.profile-draft.name = self.text; }
                                        }
                                    }

                                    // 命令
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: "命令";
                                            color: root.c-text-secondary;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                            width: 90px;
                                        }
                                        TextInput {
                                            font-size: 14px;
                                            width: 250px;
                                            text: root.profile-draft.command;
                                            edited => { root.profile-draft.command = self.text; }
                                        }
                                    }

                                    // 参数
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: "参数";
                                            color: root.c-text-secondary;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                            width: 90px;
                                        }
                                        TextInput {
                                            font-size: 14px;
                                            width: 250px;
                                            text: root.profile-draft.args;
                                            edited => { root.profile-draft.args = self.text; }
                                        }
                                    }

                                    // 工作目录
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: "工作目录";
                                            color: root.c-text-secondary;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                            width: 90px;
                                        }
                                        TextInput {
                                            font-size: 14px;
                                            width: 250px;
                                            text: root.profile-draft.working-directory;
                                            edited => { root.profile-draft.working-directory = self.text; }
                                        }
                                    }

                                    // 环境变量
                                    VerticalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: "环境变量";
                                            color: root.c-text-secondary;
                                            font-size: 14px;
                                        }
                                        Text {
                                            text: "每行 KEY=VALUE 格式";
                                            color: root.c-text-hint;
                                            font-size: 12px;
                                        }
                                        Rectangle {
                                            height: 80px;
                                            background: #ffffff;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: root.c-border;
                                            clip: true;
                                            TextInput {
                                                font-size: 14px;
                                                text: root.profile-draft.env-vars;
                                                single-line: false;
                                                wrap: word-wrap;
                                                edited => {
                                                    root.profile-draft.env-vars = self.text;
                                                }
                                            }
                                        }
                                    }
                                }

                                Rectangle { vertical-stretch: 1; }

                                // 操作按钮：删除 + 保存
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 10px;

                                    // 删除按钮（功能自原列表面板迁入）
                                    Rectangle {
                                        width: 104px;
                                        height: 32px;
                                        background: del-btn.has-hover ? #fdecec : #ffffff;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: root.c-danger;
                                        Text {
                                            text: "删除启动项";
                                            color: root.c-danger;
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        del-btn := TouchArea {
                                            clicked => {
                                                if root.profile-list.length > 0 {
                                                    root.delete-profile(root.profile-draft.id);
                                                }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 100px;
                                        height: 32px;
                                        background: save-prof.has-hover ? root.c-primary-hover : root.c-primary;
                                        border-radius: 4px;
                                        Text {
                                            text: "保存修改";
                                            color: #ffffff;
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        save-prof := TouchArea {
                                            clicked => {
                                                root.save-profile(root.profile-draft);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

            // ─── 底部按钮栏 ───
            Rectangle {
                height: 52px;
                background: #fafbfc;

                Rectangle {
                    y: 0;
                    height: 1px;
                    background: root.c-border;
                }

                HorizontalLayout {
                    padding-right: 20px;
                    spacing: 10px;
                    alignment: end;

                    // 取消按钮
                    Rectangle {
                        width: 88px;
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        background: cancel-touch.has-hover ? root.c-hover : #ffffff;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.c-border;
                        Text {
                            text: "关闭";
                            color: root.c-text;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cancel-touch := TouchArea {
                            clicked => {
                                root.cancelled();
                            }
                        }
                    }

                    // 保存通用配置按钮（仅通用配置页显示）
                    if root.active-tab == 0 : Rectangle {
                        width: 88px;
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        background: save-gen.has-hover ? root.c-primary-hover : root.c-primary;
                        border-radius: 4px;
                        Text {
                            text: "保存";
                            color: #ffffff;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        save-gen := TouchArea {
                            clicked => {
                                root.save-general(root.general-draft);
                            }
                        }
                    }
                }
            }
        }
    }
}
