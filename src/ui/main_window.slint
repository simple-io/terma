// main_window.slint — 主窗口
//
// 顶层组件，由 Rust 侧 App 持有。负责组合 TabBar + TerminalView + ProfileMenu。
//
// 数据流：
//   Rust App
//        │  (tabs / active state / config list / cells / cursor)
//        ▼
//   MainWindow (in/out properties)
//        │
//        ├── TabBar      ──callbacks──> back to Rust
//        ├── TerminalView (Cell 网格 + keyboard)
//        └── ProfileMenu

import { TabBar, TabInfo } from "tab_bar.slint";
import { TerminalView, CellRun } from "terminal_view.slint";
import { ProfileMenu, ProfileInfo } from "profile_menu.slint";
import { SettingsWindow, GeneralSettingsInfo, ProfileEditInfo, FontEntry, ColorSchemeEntry, SchemeColors } from "settings_window.slint";
import { AboutWindow, AboutInfo } from "about_window.slint";

// 导入内置字体
import "../../fonts/JetBrainsMono-Regular.ttf";
import "../../fonts/JetBrainsMono-Bold.ttf";
import "../../fonts/CascadiaCode.ttf";


export { SettingsWindow, GeneralSettingsInfo, ProfileEditInfo, FontEntry, ColorSchemeEntry, SchemeColors }
export { AboutWindow, AboutInfo }

export component MainWindow inherits Window {
    // ─── 基本设置 ───
    // 主窗口标题
    title: "terma";
    // 窗口最小尺寸
    min-width: 20px;
    // 窗口初始宽度
    preferred-width: 880px;
    // 窗口初始高度
    preferred-height: 621px;
    // 终端初始背景色
    in-out property <color> bg-color: #000000;
    // 光标色（全局外观项，60% 不透明度，Rust 侧按配置注入覆盖）
    in-out property <color> cursor-color: #ffffff99;
    // 光标样式：block / beam / underline
    in-out property <string> cursor-style: "block";
    // 光标闪烁开关
    in-out property <bool> cursor-blink: true;
    background: root.bg-color;

    // ─── 终端字体设置 ───
    // 终端字体类型
    in-out property <string> font-family: "JetBrains Mono";
    // 终端字号（逻辑像素，Rust 侧注入，由设置项 font-size 驱动）
    in-out property <length> font-size: 12px;
    // 字体宽度
    in-out property <length> char-w: 8px;
    // 字体高度
    in-out property <length> char-h: 16px;

    // ─── 对外暴露的数据属性（Rust 侧写入） ───
    // 会话标签
    in-out property <[TabInfo]> tabs;
    // 单标签宽度（逻辑像素），Rust 侧按窗口宽度与标签数计算后注入
    in-out property <length> tab-width: 160px;
    // 配置文件
    in-out property <[ProfileInfo]> profiles;
    in-out property <string> active-title;
    in-out property <string> active-profile-name;
    // 终端网格数据（二维：外层为行，内层为该行 CellRun）
    in-out property <[[CellRun]]> cells;
    in-out property <int> cursor-row;
    in-out property <int> cursor-col;
    in-out property <bool> cursor-visible;
    in-out property <bool> profile-menu-visible: false;
    // 滚动（scrollback 历史查看）
    in-out property <bool> has-scrollback;
    in-out property <float> scroll-ratio;
    in-out property <float> viewport-ratio;

    // ─── 回调（Rust 侧绑定处理逻辑） ───
    callback new-tab();
    callback close-tab(string);
    callback select-tab(string);
    callback select-profile(string);
    callback open-settings();
    callback open-about();
    callback key-pressed(string, KeyboardModifiers) -> bool;
    callback ime-commit(string);
    callback terminal-clicked();
    // 滚动交互：滚轮与滚动条
    callback scroll-delta(length);
    callback scroll-to(float);
    // 窗口尺寸变化（由 width/height 属性变更即时触发，替代轮询检测）
    callback resized();

    // 窗口初始焦点转发到终端区域：TerminalView 内部再 forward-focus 到隐藏的 ime-input，
    // 使窗口一显示即可接收键盘/输入法输入，无需先点击终端区。显式 .focus()（如点击标签、
    // 打开菜单弹层）不受影响，forward-focus 仅在窗口自身获得焦点时决定初始落点。
    forward-focus: terminal-area;

    // 窗口尺寸变化即时回调：width/height 任一变更即通知 Rust 侧同步网格 + PTY 并重绘。
    // Slint 后端在收到系统 resize 事件后更新 WindowItem 的 width/height，进而触发下述 changed 回调。
    changed width => {
        root.resized();
    }
    changed height => {
        root.resized();
    }

    VerticalLayout {
        // Tab 栏
        tab-bar := TabBar {
            tabs: root.tabs;
            tab-width: root.tab-width;
            default-profile-name: "Default";
            new-tab => { root.new-tab(); }
            close-tab(id) => { root.close-tab(id); }
            select-tab(id) => { root.select-tab(id); }
            show-profile-menu => {
                root.profile-menu-visible = !root.profile-menu-visible;
            }
        }

        // 间隔占位：标签和内容之间留 4px 间距
        Rectangle {
            height: 4px;
            background: transparent;
        }

        // Terminal 区域
        terminal-area := TerminalView {
            cells: root.cells;
            font-family: root.font-family;
            font-size: root.font-size;
            char-w: root.char-w;
            char-h: root.char-h;
            bg-color: root.bg-color;
            cursor-color: root.cursor-color;
            cursor-style: root.cursor-style;
            cursor-blink: root.cursor-blink;
            cursor-row: root.cursor-row;
            cursor-col: root.cursor-col;
            cursor-visible: root.cursor-visible;
            has-scrollback: root.has-scrollback;
            scroll-ratio: root.scroll-ratio;
            viewport-ratio: root.viewport-ratio;
            key-pressed(text, mods) => {
                root.key-pressed(text, mods)
            }
            ime-commit(text) => {
                root.ime-commit(text)
            }
            clicked => {
                root.terminal-clicked();
            }
            scroll-delta(dy) => {
                root.scroll-delta(dy)
            }
            scroll-to(ratio) => {
                root.scroll-to(ratio)
            }
        }
    }

    // 菜单打开时的全窗口透明遮罩：点击菜单以外任意区域即隐藏（失焦关闭）。
    // 置于 profile-menu 之前，确保菜单本身渲染在遮罩之上，菜单项点击不受影响。
    if root.profile-menu-visible : TouchArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        clicked => {
            root.profile-menu-visible = false;
        }
    }

    // Profile 下拉菜单（浮层，跟随 menu-touch 按钮位置动态展开）
    profile-menu := ProfileMenu {
        width: 170px;
        // y 坐标：TabBar 底部（menu-touch 按钮下方）
        y: tab-bar.height + 2px;
        // x 坐标动态计算（基于 menu-touch 按钮在窗口内的位置 + 窗口宽度）：
        //   menu-touch 右边缘 = menu-touch-x + menu-touch-width
        //   右侧剩余空间 = 窗口宽度 − menu-touch 右边缘
        //   左侧剩余空间 = menu-touch-x
        //   若右侧空间 ≥ 菜单宽度 → 菜单在 menu-touch 右侧展开
        //   若右侧不足且左侧 ≥ 菜单宽度 → 菜单在 menu-touch 左侧展开
        //   两侧均不足 → 默认在右侧展开
        x: (root.width - (tab-bar.menu-touch-x + tab-bar.menu-touch-width) >= self.width)
            ? (tab-bar.menu-touch-x + tab-bar.menu-touch-width)
            : (tab-bar.menu-touch-x >= self.width
                ? (tab-bar.menu-touch-x - self.width)
                : (tab-bar.menu-touch-x + tab-bar.menu-touch-width));
        profiles: root.profiles;
        menu-visible: root.profile-menu-visible;
        select-profile(pid) => {
            root.select-profile(pid);
            root.profile-menu-visible = false;
        }
        open-settings => {
            root.open-settings();
            root.profile-menu-visible = false;
        }
        open-about => {
            root.open-about();
            root.profile-menu-visible = false;
        }
        dismissed => {
            root.profile-menu-visible = false;
        }
    }
}
