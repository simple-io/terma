// profile_menu.slint — Profile 下拉菜单
//
// 职责：
//   - 显示可用的 Profile 列表
//   - 用户选中某项时触发 select-profile 回调
//   - 底部提供「设置」入口，打开独立配置窗口
//   - 底部提供「关于」入口，打开软件信息窗口
//
// 通信：
//   入：profiles (Model<ProfileInfo>)
//   出：callback select-profile(profile-id)
//   出：callback open-settings()
//   出：callback open-about()
//   出：callback dismissed()

export struct ProfileInfo {
    id: string,
    name: string,
    command: string,
}

export component ProfileMenu inherits Rectangle {
    in property <[ProfileInfo]> profiles;
    in property <bool> menu-visible: false;

    callback select-profile(string /* profile-id */);
    callback dismissed();
    callback open-settings();
    callback open-about();

    // 简单垂直列表浮层
    if menu-visible : vertical-layout := VerticalLayout {
        Rectangle {
            background: #2d2d2d;
            border-radius: 6px;
            border-width: 1px;
            border-color: #444;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000066;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                for profile[i] in profiles : Rectangle {
                    height: 30px;
                    background: touch.pressed ? #3a3a3a : (touch.has-hover ? #353535 : transparent);
                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 8px;
                        Text {
                            text: profile.name;
                            color: #e6e6e6;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                    touch := TouchArea {
                        clicked => {
                            root.select-profile(profile.id);
                            root.dismissed();
                        }
                    }
                }

                // ── 分隔线 ──
                Rectangle {
                    height: 5px;
                    background: transparent;
                    Rectangle {
                        y: 2px;
                        height: 1px;
                        width: parent.width - 8px;
                        x: 4px;
                        background: #444;
                    }
                }

                // ── 设置选项 ──
                Rectangle {
                    height: 30px;
                    background: settings-touch.pressed ? #3a3a3a : (settings-touch.has-hover ? #353535 : transparent);
                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 8px;
                        Text {
                            text: "\u{2699} 设置...";
                            color: #e6e6e6;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                    settings-touch := TouchArea {
                        clicked => {
                            root.open-settings();
                            root.dismissed();
                        }
                    }
                }

                // ── 关于选项 ──
                Rectangle {
                    height: 30px;
                    background: about-touch.pressed ? #3a3a3a : (about-touch.has-hover ? #353535 : transparent);
                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 8px;
                        Text {
                            text: "\u{2139} 关于";
                            color: #e6e6e6;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                    about-touch := TouchArea {
                        clicked => {
                            root.open-about();
                            root.dismissed();
                        }
                    }
                }
            }
        }
    }
}
