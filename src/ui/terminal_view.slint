// terminal_view.slint — Terminal 渲染区域（Cell 网格）
//
// Phase 4：按 Run 绝对定位渲染字符（等宽字体），支持前景/背景色、粗体、下划线、光标块。
// 字符度量：char-w / char-h 为等宽字体的 advance / 行高（可调）。
//
// 通信：
//   in:  cells ([CellRun])、cursor-row/col/visible、char-w/char-h
//   out: callback key-pressed(string, KeyboardModifiers) -> bool
//   out: callback clicked()

export struct CellRun {
    // 文本内容、行号、列号、长度、前景色、背景色、是否有背景色、粗体、斜体、下划线
    // 文本内容
    text: string,
    // 行号
    row: int,
    // 列号
    col: int,
    // 该字符的显示宽度（1 或 2，CJK 等宽字符为 2），用于计算格子宽度 = len * char-w
    len: int,
    // 前景色
    fg: brush,
    // 背景色
    bg: brush,
    // 是否有背景色
    has-bg: bool,
    // 是否粗体
    bold: bool,
    // 是否斜体
    italic: bool,
    // 是否下划线
    underline: bool,
}

export component TerminalView inherits Rectangle {
    // 终端元素单元格，用于渲染终端内容，使用二维数组，以行和列表示所有内容。
    in property <[[CellRun]]> cells;
    in property <int> cursor-row;
    in property <int> cursor-col;
    in property <bool> cursor-visible;
    in property <length> char-w: 8px;
    in property <length> char-h: 16px;
    // 终端字体（从 Rust 注入）
    in property <string> font-family: "JetBrains Mono";

    // ─── 滚动（scrollback 历史查看） ───
    // 是否显示滚动条
    in property <bool> has-scrollback;
    // 滚动条的位置, 按照比例模式计算：0 = 底部（最新），1 = 顶部（最老历史）
    in property <float> scroll-ratio: 0;
    // 滚动条的大小, 按照窗口高度比例计算（历史 + 当前屏），用于计算滚动条滑块高度
    in property <float> viewport-ratio: 1;

    // ─── 滚动条显隐（自动隐藏机制） ───
    // 滚动条默认隐藏，仅在滚动交互（滚轮 / 拖动 / 点击滚动条）时短暂显示；
    // 每次交互重置 3 秒计时，超时自动隐藏。此状态由 UI 层独立管理，无需 Rust 侧介入。
    property <bool> scrollbar-visible: false;

    callback key-pressed(string, KeyboardModifiers) -> bool;
    // IME 输入法提交：当用户通过输入法完成中文/复杂字符输入时，把提交的完整字符串
    // 上抛给 Rust 层，由 Rust 层转为 UTF-8 字节写入 PTY（区别于 key-pressed 的按键路径）。
    callback ime-commit(string);
    callback clicked();
    // 鼠标滚轮滚动：参数为竖直方向滚动量（像素，正 = 向上滚入历史）
    callback scroll-delta(length);
    // 滚动条拖动/点击：参数为目标位置比例（0 = 底部，1 = 顶部）
    callback scroll-to(float);

    // 焦点转发：无论终端区域内哪个元素被聚焦，最终都把键盘焦点落到隐藏的
    // ime-input TextInput 上，从而唤起系统输入法（IME）。Slint 中只有 TextInput
    // 在获得焦点时会请求启用系统 IME，普通 FocusScope 不会。
    forward-focus: ime-input;

    background: #000000;

    // 显示滚动条并重置 3 秒自动隐藏计时（滚动交互时调用）
    function show-scrollbar() {
        root.scrollbar-visible = true;
        // 重置 3 秒自动隐藏倒计时：先停后启，确保每次滚动交互都从头计时
        hide-timer.stop();
        hide-timer.start();
    }

    // 3 秒无滚动交互后自动隐藏滚动条
    hide-timer := Timer {
        interval: 3s;
        running: false;
        triggered => {
            root.scrollbar-visible = false;
            self.running = false;
        }
    }

    // 光标块（半透明高亮）
    if root.cursor-visible: Rectangle {
        x: root.cursor-col * root.char-w;
        y: root.cursor-row * root.char-h;
        width: root.char-w;
        height: root.char-h;
        background: #ffffff44;
    }

    // 字符渲染项列表：外层遍历「行 model」，内层遍历该行内的每个 CellRun。
    // 行容器铺满整个视口且透明，内部仍按 col/row 绝对定位到 char-w/char-h 的整数倍网格，
    // 因此不依赖字体 advance 宽度是否恰好等于 char-w，从根上消除单行内的累积对齐漂移。
    for row in root.cells: Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        for cell in row: Rectangle {
            x: cell.col * root.char-w;
            y: cell.row * root.char-h;
            width: cell.len * root.char-w;
            height: root.char-h;
            background: cell.has-bg ? cell.bg : transparent;

            Text {
                text: cell.text;
                color: cell.fg;
                font-size: 13px;
                font-family: root.font-family;
                font-weight: cell.bold ? 700 : 400;
                horizontal-alignment: left;
                vertical-alignment: center;
                // 裁剪超出格子的部分，防止宽字符在字体度量略大于 char-w 时溢出到相邻格
                overflow: clip;
            }

            // 下划线
            if cell.underline: Rectangle {
                y: parent.height - 2px;
                width: parent.width;
                height: 1px;
                background: cell.fg;
            }
        }
    }

    // ─── IME 输入法捕获锚点 ───
    // 一个 1×1 像素的透明 TextInput，跟随终端光标定位，作为键盘与 IME 事件的唯一入口：
    //   - Slint 中只有 TextInput 获得焦点时才会向系统请求启用 IME（input_method_request::Enable），
    //     普通 FocusScope 不会唤起输入法，因此必须用 TextInput 作为焦点承载者。
    //   - key-pressed：处理普通按键（英文、组合快捷键、方向键等），全部 accept 并转发给
    //     root.key-pressed → encode_key → PTY，避免 TextInput 自己把字符插入 text。
    //   - edited：捕获输入法提交（CommitComposition）。IME 的预编辑（拼音）只更新内部
    //     preedit 状态、不会触发 edited；只有用户选词提交时才会触发 edited，此时 self.text
    //     即提交的完整字符串，转发给 root.ime-commit 写入 PTY，随后清空 text 以接收下一次提交。
    //   - 位置跟随光标，使系统 IME 候选框出现在实际插入点附近；滚动历史（光标隐藏）时移到屏外。
    ime-input := TextInput {
        x: root.cursor-visible ? max(0px, root.cursor-col * root.char-w) : -1000px;
        y: root.cursor-visible ? root.cursor-row * root.char-h : -1000px;
        width: 1px;
        height: 1px;
        // 完全透明、隐藏光标，不产生任何视觉元素
        opacity: 0;
        text-cursor-width: 0px;
        single-line: true;

        key-pressed(e) => {
            if root.key-pressed(e.text, e.modifiers) {
                accept
            } else {
                reject
            }
        }

        edited => {
            // 仅当不在预编辑（拼音）状态且存在已提交文本时，才把提交结果写入 PTY
            if (self.preedit-text == "" && self.text != "") {
                root.ime-commit(self.text);
                self.text = "";
            }
        }
    }

    // 点击终端区域获取焦点
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            ime-input.focus();
            root.clicked();
        }
        // 鼠标滚轮：滚入/滚出历史
        scroll-event(event) => {
            root.scroll-delta(event.delta-y);
            root.show-scrollbar();
            accept
        }
    }

    // 右侧滚动条（有历史内容且滚动交互后短暂显示，3 秒无交互自动隐藏）
    if root.has-scrollback && root.scrollbar-visible: scrollbar := Rectangle {
        y: 0px;
        x: parent.width - 12px;
        width: 8px;
        height: parent.height - 10px;
        // 轨道保持透明，避免遮挡下方终端文字（仅滑块着色）
        background: transparent;
        // border-width: 1px;
        // border-color: #8885;

        // 滚动条滑块的长度
        property <length> thumb-height: max(16px, self.height * root.viewport-ratio);
        // 滚动条滑块的位置
        property <length> thumb-y: (self.height - self.thumb-height) * (1.0 - root.scroll-ratio);

        // 滚动条滑块（低不透明度，重叠时尽量不遮挡文字）
        thumb := Rectangle {
            x: 1px;
            width: 6px;
            height: parent.thumb-height;
            y: parent.thumb-y;
            border-radius: 2px;
            background: #888a;
        }

        // 拖动手势区：点击跳转 + 拖动滚动
        touch := TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.scroll-to(scrollbar.ratio-from-y(self.mouse-y));
                    root.show-scrollbar();
                }
            }
            moved => {
                if (self.pressed) {
                    root.scroll-to(scrollbar.ratio-from-y(self.mouse-y));
                    root.show-scrollbar();
                }
            }
            // 滚动条上滚轮同样生效
            scroll-event(event) => {
                root.scroll-delta(event.delta-y);
                root.show-scrollbar();
                accept
            }
        }

        // 由鼠标 y 坐标换算滚动比例（0 = 底部，1 = 顶部），滑块中心对齐光标
        function ratio-from-y(y: length) -> float {
            let track = parent.height;
            let th = self.thumb-height;
            if (track <= th) {
                return 0;
            }
            let clamped = max(0px, min(y - th / 2, track - th));
            return 1.0 - (clamped / (track - th));
        }
    }
}
