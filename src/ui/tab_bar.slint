// tab_bar.slint — Tab 栏（Windows Terminal 风格）
//
// 职责：
//   - 横向排列所有 Tab
//   - 每个 Tab 显示标题 + 关闭按钮 (×)
//   - 激活态 Tab 高亮
//   - 右侧 + 按钮创建新 Tab（默认 Profile）
//   - ▼ 按钮展开 Profile 菜单
//
// 通信（全部回调上抛到 MainWindow）：
//   out: callback new-tab()
//   out: callback close-tab(string id)
//   out: callback select-tab(string id)
//   out: callback show-profile-menu()

export struct TabInfo {
    id: string,
    title: string,
    active: bool,
    profile-name: string,
}

export component TabBar inherits HorizontalLayout {
    in property <[TabInfo]> tabs;
    in property <string> default-profile-name;

    callback new-tab();
    callback close-tab(string);
    callback select-tab(string);
    callback show-profile-menu();

    spacing: 2px;
    padding: 0px;
    height: 32px;

    // Tab 列表
    for tab in tabs : tab-item := Rectangle {
        width: 160px;
        height: 100%;
        background: tab.active ? #2d2d2d : (self-touch.has-hover ? #252525 : #1f1f1f);
        border-radius: 6px;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 6px;

            // 标题
            Text {
                text: tab.title;
                color: tab.active ? #ffffff : #aaaaaa;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }

            // 弹性占位
            Rectangle { horizontal-stretch: 1; }

            // 关闭按钮 ×
            close-touch := TouchArea {
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.close-tab(tab.id);
                }
                Rectangle {
                    background: close-touch.has-hover ? #e81123aa : transparent;
                    border-radius: 4px;
                    width: 18px;
                    height: 18px;
                    Text {
                        text: "\u{00D7}";  // ×
                        color: close-touch.has-hover ? #ffffff : #888;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 整个 Tab 的点击区域（排除关闭按钮区域）
        self-touch := TouchArea {
            clicked => {
                root.select-tab(tab.id);
            }
        }
    }

    // + 按钮：用默认 Profile 创建新 Tab
    add-touch := TouchArea {
        width: 30px;
        height: 100%;
        clicked => {
            root.new-tab();
        }
        Rectangle {
            background: add-touch.has-hover ? #2d2d2d : transparent;
            border-radius: 6px;
            width: 30px;
            height: 36px;
            Text {
                text: "+";
                color: #cccccc;
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // ▼ 按钮：展开 Profile 菜单
    menu-touch := TouchArea {
        width: 30px;
        height: 36px;
        clicked => {
            root.show-profile-menu();
        }
        Rectangle {
            background: menu-touch.has-hover ? #2d2d2d : transparent;
            border-radius: 6px;
            width: 30px;
            height: 36px;
            Text {
                text: "\u{25BC}";  // ▼
                color: #cccccc;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // 弹性填充
    Rectangle { horizontal-stretch: 1; }
}
